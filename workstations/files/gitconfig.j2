[credential]
	credentialStore = secretservice
	helper =
	helper = {{ fedora_user_files_home }}/.dotnet/tools/git-credential-manager
[credential "https://dev.azure.com"]
	useHttpPath = true
[user]
	email = {{ git_user_email }}
	name = {{ git_user_name }}
[pull]
	rebase = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
